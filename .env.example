# Copy this file to .env and fill in real values.
# Docker Compose reads .env automatically; for local dev without Docker,
# export these variables in your shell or use a tool like direnv.

# ─── Production (required for docker-compose.prod.yml) ───────────────────────
# DOMAIN=trippier.dev          # base domain — services are exposed at api.poi.$DOMAIN, api.ai.$DOMAIN, $DOMAIN
# ACME_EMAIL=you@example.com   # Let's Encrypt registration email
# OWNER=your-ghcr-org-or-user  # GitHub Container Registry namespace for images

# ─── Shared secret (must be the same value everywhere) ───────────────────────
INTERNAL_SECRET=change-me-internal-secret

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=trippier
POSTGRES_PASSWORD=trippier
POSTGRES_DB=trippier

# ─── auth-api ────────────────────────────────────────────────────────────────
AUTH_PORT=8081
AUTH_DATABASE_URL=postgres://trippier:trippier@localhost:5432/trippier?sslmode=disable
AUTH_REDIS_URL=redis://localhost:6379
AUTH_JWT_SECRET=change-me-in-production-32-chars!!
AUTH_INTERNAL_SECRET=change-me-internal-secret
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_SMTP_FROM=noreply@trippier.dev
# For production (e.g. Resend): set SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASS=re_xxx
AUTH_APP_URL=http://localhost:3000
# Per-user quota lives in the users table (defaults 1000 tokens / 30-day window).
# Override per user via POST /internal/admin/user-quota.

# ─── poi-api ─────────────────────────────────────────────────────────────────
POI_PORT=8080
POI_REDIS_URL=redis://localhost:6379
POI_CACHE_TTL_SECONDS=3600
POI_PROVIDER_TIMEOUT=8
POI_LANG=en
POI_LOG_LEVEL=info
POI_AUTH_API_URL=http://localhost:8081
POI_INTERNAL_SECRET=change-me-internal-secret
# Optional — free account at https://www.geonames.org/login
POI_GEONAMES_USERNAME=

# ─── itinerary-api ───────────────────────────────────────────────────────────
POI_API_URL=http://localhost:8080
POI_CLIENT_TIMEOUT=10.0
LOG_LEVEL=info
AUTH_API_URL=http://localhost:8081

# ─── admin ───────────────────────────────────────────────────────────────────
# Comma-separated list of emails that have admin access to the roadmap editor.
# PUBLIC_ADMIN_EMAILS is exposed to the browser (UI gating only).
# ADMIN_EMAILS is server-side only (authoritative, checked on PUT /api/roadmap).
PUBLIC_ADMIN_EMAILS=admin@example.com
ADMIN_EMAILS=admin@example.com

# ─── frontend ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
PUBLIC_DOCS_URL=http://localhost:5173
# Server-side URLs used by the SvelteKit proxy (never exposed to the browser)
FRONTEND_POI_API_URL=http://localhost:8080
FRONTEND_ITINERARY_API_URL=http://localhost:8000
INTERNAL_SECRET=change-me-internal-secret

# ─── Ports (override for docker-compose.full.yml) ────────────────────────────
AUTH_API_PORT=8081
POI_API_PORT=8080
ITINERARY_API_PORT=8000
FRONTEND_PORT=3000
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

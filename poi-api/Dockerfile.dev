# syntax=docker/dockerfile:1
FROM golang:1.26-alpine
WORKDIR /app

# build-base is required by the H3 v4 cgo binding (github.com/uber/h3-go/v4);
# curl lets the container report health via the HEALTHCHECK probe below.
RUN apk add --no-cache build-base curl
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@v1.61.1

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Source is mounted via volume in docker-compose.override.yml.
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS http://localhost:8080/health || exit 1

CMD ["air"]

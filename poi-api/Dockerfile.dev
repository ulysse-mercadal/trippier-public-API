FROM golang:1.24-alpine
WORKDIR /app
# build-base is required by the H3 v4 cgo binding (github.com/uber/h3-go/v4).
RUN apk add --no-cache build-base && go install github.com/air-verse/air@v1.61.1
COPY go.mod go.sum ./
RUN go mod download
# Source is mounted via volume in docker-compose.dev.yml
EXPOSE 8080
CMD ["air"]
